<Window x:Class="Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copilot Session Dashboard"
        Width="1280"
        Height="800"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="WebViewHost" Visibility="Collapsed" />

        <TextBlock x:Name="StatusPanel"
                   Text="Starting Copilot Session Dashboard…"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <StackPanel x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    MaxWidth="720"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Copilot Session Dashboard could not start"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <TextBlock x:Name="ErrorReason" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12" />
            <TextBox x:Name="ErrorDetail"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MaxHeight="200"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
                <Run Text="Log folder: " />
                <Run x:Name="ErrorLogDir" />
            </TextBlock>
            <Button x:Name="RetryButton"
                    Content="Retry"
                    Padding="16,4"
                    HorizontalAlignment="Left"
                    Click="OnRetryClick" />
        </StackPanel>
    </Grid>
</Window>
